## # i18n/loader
##
## Translation directory loader for every supported format.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Layout: `dir/<lang>.<ext>` files define the `<lang>` table; files inside
## a language subdirectory are namespaced (`dir/de/app.json` defines `de`
## keys under `app.`). Only one subdirectory level is used.
## Output is a flat `"lang\nkey"` -> template map (see types.alya).
##
## Precedence (later wins): json, yaml, toml, csv, tsv, tr.

import "std/fs"
import "std/str"
import "./tr_parser.alya"
import "./json_loader.alya"
import "./yaml_loader.alya"
import "./toml_loader.alya"
import "./csv_loader.alya"

## Maps a file name to its loader kind ("tr", "json", "yaml", "toml",
## "csv", "tsv", or "" when unsupported).
function file_kind(name: string) -> string
    if ends_with(name, ".tr") == 1 or ends_with(name, ".TR") == 1
        return "tr"
    end
    if ends_with(name, ".json") == 1 or ends_with(name, ".JSON") == 1
        return "json"
    end
    if ends_with(name, ".yaml") == 1 or ends_with(name, ".YAML") == 1
        return "yaml"
    end
    if ends_with(name, ".yml") == 1 or ends_with(name, ".YML") == 1
        return "yaml"
    end
    if ends_with(name, ".toml") == 1 or ends_with(name, ".TOML") == 1
        return "toml"
    end
    if ends_with(name, ".csv") == 1 or ends_with(name, ".CSV") == 1
        return "csv"
    end
    if ends_with(name, ".tsv") == 1 or ends_with(name, ".TSV") == 1
        return "tsv"
    end
    return ""
end

## Returns the language id from a file name ("en.tr" -> "en").
function file_lang(name: string) -> string
    let dot = last_index_of(name, ".")
    if dot <= 0
        return ""
    end
    return name[..dot]
end

## Parses translation text of the given kind into a flat map.
function parse_kind_text(kind: string, text) -> map
    if kind == "tr"
        return parse_tr_text(text)
    end
    if kind == "json"
        return parse_json_text(text)
    end
    if kind == "yaml"
        return parse_yaml_text(text)
    end
    if kind == "toml"
        return parse_toml_text(text)
    end
    if kind == "csv"
        return parse_csv_text(text)
    end
    return parse_tsv_text(text)
end

## Merges one translation file into the aggregate flat table.
function merge_file(all, path: string, lang: string, ns: string, kind: string)
    let flat = parse_kind_text(kind, fs_read(path))
    for k in keys(flat)
        let fk = k
        if len(ns) > 0
            fk = ns + "." + k
        end
        all[lang + "\n" + fk] = flat[k]
    end
end

## Loads namespaced files of one kind from a language subdirectory.
function load_subdir(all, dir: string, lang: string, kind: string)
    let entries = fs_list_dir(dir)
    for e in entries
        let full = dir + "/" + e
        if fs_is_dir(full) == 1
            continue
        end
        if file_kind(e) != kind
            continue
        end
        let ns = file_lang(e)
        if len(ns) == 0
            continue
        end
        merge_file(all, full, lang, ns, kind)
    end
end

## Loads one kind over a directory level (top-level files + one subdir level).
function load_kind(all, dir: string, ns: string, kind: string)
    let entries = fs_list_dir(dir)
    for e in entries
        let full = dir + "/" + e
        if fs_is_dir(full) == 1
            if len(ns) == 0
                load_subdir(all, full, e, kind)
            end
        else
            if file_kind(e) == kind
                load_top_file(all, full, e, ns, kind)
            end
        end
    end
end

## Loads a single top-level translation file.
function load_top_file(all, full: string, name: string, ns: string, kind: string)
    let lang = file_lang(name)
    if len(lang) == 0
        return
    end
    merge_file(all, full, lang, ns, kind)
end

## Loads a translation directory into a flat message table.
##
## ### Parameters
## - `dir`: Directory with `<lang>.<ext>` translation files.
##
## ### Returns
## Flat `"lang\nkey"` -> template map.
pub function load_dir(dir: string) -> map
    let all = map()
    let kinds = ["json", "yaml", "toml", "csv", "tsv", "tr"]
    for kind in kinds
        load_kind(all, dir, "", kind)
    end
    return all
end
