## i18n Library Facade
##
## Lightweight internationalization for Alya: locale bundles, gettext-style
## `.tr` and flat-JSON loaders, CLDR-lite plurals, `{placeholder}` formatting.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "std/str"
import "./types.alya"
import "./tr_parser.alya"
import "./json_loader.alya"
import "./plural.alya"
import "./format.alya"
import "./detect.alya"
import "./loader.alya"

# ───────────────────────────────────────────────────────────────
# Bundle Loading
# ───────────────────────────────────────────────────────────────

## Loads a translation directory into a bundle.
##
## When `lang` is empty, the system language is auto-detected.
##
## ### Parameters
## - `dir`: Directory with `<lang>.tr` / `<lang>.json` files.
## - `lang`: Active language id ("" for auto-detect).
## - `fallback`: Fallback language id. Defaults to `"en"`.
##
## ### Returns
## Populated `I18nBundle`.
pub function load_bundle(dir: string, lang: string = "", fallback: string = "en") -> I18nBundle
    let use_lang = lang
    if len(use_lang) == 0
        use_lang = detect_lang(fallback)
    end
    return I18nBundle {
        messages: load_dir(dir),
        lang: use_lang,
        fallback: fallback
    }
end

## Detects the system language tag, falling back to default_lang.
pub function system_language(default_lang: string = "en") -> string
    return detect_lang(default_lang)
end

# ───────────────────────────────────────────────────────────────
# Lookup Core
# ───────────────────────────────────────────────────────────────

## Returns the lookup chain: lang, base, fallback, fallback base (deduplicated).
pub function fallback_chain(bundle, lang: string) -> array
    let out = []
    if len(lang) > 0
        out.push(lang)
    end
    let bl = base_lang(lang)
    if len(bl) > 0 and bl != lang
        out.push(bl)
    end
    let fb = bundle.fallback
    if len(fb) > 0 and fb != lang and fb != bl
        out.push(fb)
    end
    let bf = base_lang(bundle.fallback)
    if len(bf) > 0 and bf != lang and bf != bl and bf != fb
        out.push(bf)
    end
    return out
end

## Returns the raw template for key, or null when untranslated.
pub function find_raw(bundle, lang: string, key: string)
    let cands = []
    cands.push(lang)
    cands.push(base_lang(lang))
    cands.push(bundle.fallback)
    cands.push(base_lang(bundle.fallback))
    for l in cands
        let ck = l + "\n" + key
        if ck in bundle.messages
            return str_from_ptr(bundle.messages[ck])
        end
    end
    return null
end

## Copies string vars and injects the count placeholder.
pub function vars_with_count(vars, n: int)
    let out = map()
    if vars is not null
        for k in keys(vars)
            out[k] = str_from_ptr(vars[k])
        end
    end
    out["count"] = str(n)
    return out
end

# ───────────────────────────────────────────────────────────────
# Translation API
# ───────────────────────────────────────────────────────────────

## Translates key in the bundle language with optional placeholders.
##
## Falls back through base language and bundle fallback; returns the key
## itself when untranslated. Placeholder values must be strings.
##
## ### Parameters
## - `bundle`: Source `I18nBundle`.
## - `key`: Translation key (`"menu.file"`).
## - `vars`: Placeholder name -> string value map (or null).
##
## ### Returns
## Interpolated translation string.
pub function t(bundle, key: string, vars = null) -> string
    let raw = find_raw(bundle, bundle.lang, key)
    if raw is null
        return key
    end
    return interpolate(raw, vars)
end

## Translates a plural key for count n with optional placeholders.
##
## Pipe templates (`"one|other"`, `"one|few|many"`) select positionally by
## language form order; single templates are used as-is. The count is
## injected as `{count}`.
##
## ### Parameters
## - `bundle`: Source `I18nBundle`.
## - `key`: Translation key.
## - `n`: Item count.
## - `vars`: Placeholder name -> string value map (or null).
##
## ### Returns
## Interpolated plural string.
pub function plural(bundle, key: string, n: int, vars = null) -> string
    let raw = find_raw(bundle, bundle.lang, key)
    if raw is null
        return key
    end
    let text = raw
    if index_of(raw, "|") >= 0
        let parts = split(raw, "|")
        let order = form_order(bundle.lang)
        let cat = plural_category(bundle.lang, n)
        let idx = 0
        for f in order
            if f == cat
                break
            end
            idx += 1
        end
        if idx >= len(parts)
            idx = len(parts) - 1
        end
        text = trim(parts[idx])
    end
    return interpolate(text, vars_with_count(vars, n))
end

## Translates key in an explicit language (ignoring the bundle default).
pub function tr_in(bundle, lang: string, key: string, vars = null) -> string
    let raw = find_raw(bundle, lang, key)
    if raw is null
        return key
    end
    return interpolate(raw, vars)
end
