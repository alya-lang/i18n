## i18n Library Facade
##
## Lightweight internationalization for Alya: locale bundles, gettext-style
## `.tr` and flat-JSON loaders, CLDR-lite plurals, `{placeholder}` formatting.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "std/str"
import "./types.alya"
import "./tr_parser.alya"
import "./json_loader.alya"
import "./plural.alya"
import "./format.alya"
import "./number.alya"
import "./detect.alya"
import "./loader.alya"

# ───────────────────────────────────────────────────────────────
# Bundle Loading
# ───────────────────────────────────────────────────────────────

## Loads a translation directory into a bundle.
##
## When `lang` is empty, the system language is auto-detected.
##
## ### Parameters
## - `dir`: Directory with `<lang>.tr` / `<lang>.json` files.
## - `lang`: Active language id ("" for auto-detect).
## - `fallback`: Fallback language id. Defaults to `"en"`.
##
## ### Returns
## Populated `I18nBundle`.
pub function load_bundle(dir: string, lang: string = "", fallback: string = "en") -> I18nBundle
    let use_lang = lang
    if len(use_lang) == 0
        use_lang = detect_lang(fallback)
    end
    return I18nBundle {
        messages: load_dir(dir),
        lang: use_lang,
        fallback: fallback
    }
end

## Detects the system language tag, falling back to default_lang.
pub function system_language(default_lang: string = "en") -> string
    return detect_lang(default_lang)
end

# ───────────────────────────────────────────────────────────────
# Lookup Core
# ───────────────────────────────────────────────────────────────

## Returns the lookup chain: lang, base, fallback, fallback base (deduplicated).
pub function fallback_chain(bundle, lang: string) -> array
    let out = []
    if len(lang) > 0
        out.push(lang)
    end
    let bl = base_lang(lang)
    if len(bl) > 0 and bl != lang
        out.push(bl)
    end
    let fb = bundle.fallback
    if len(fb) > 0 and fb != lang and fb != bl
        out.push(fb)
    end
    let bf = base_lang(bundle.fallback)
    if len(bf) > 0 and bf != lang and bf != bl and bf != fb
        out.push(bf)
    end
    return out
end

## Returns the raw template for key, or null when untranslated.
pub function find_raw(bundle, lang: string, key: string)
    let chain = fallback_chain(bundle, lang)
    for l in chain
        let ck = l + "\n" + key
        if ck in bundle.messages
            return bundle.messages[ck]
        end
    end
    return null
end

## Copies string vars and injects the count placeholder.
##
## An explicitly provided `"count"` value wins over the injection.
pub function vars_with_count(vars, n: int)
    let out = map()
    if vars is not null
        for k in keys(vars)
            out[k] = vars[k]
        end
    end
    let has_count = 0
    if vars is not null
        if "count" in vars
            has_count = 1
        end
    end
    if has_count == 0
        out["count"] = str(n)
    end
    return out
end

# ───────────────────────────────────────────────────────────────
# Translation API
# ───────────────────────────────────────────────────────────────

## Translates key in the bundle language with optional placeholders.
##
## Falls back through base language and bundle fallback; returns the key
## itself when untranslated. Placeholder values must be strings.
##
## ### Parameters
## - `bundle`: Source `I18nBundle`.
## - `key`: Translation key (`"menu.file"`).
## - `vars`: Placeholder name -> string value map (or null).
##
## ### Returns
## Interpolated translation string.
pub function t(bundle, key: string, vars = null) -> string
    let raw = find_raw(bundle, bundle.lang, key)
    if raw is null
        return key
    end
    return interpolate(raw, vars)
end

## Selects the plural form from a pipe template for count n.
##
## Single templates pass through; pipe templates select positionally by
## language form order with clamping to the last form.
function select_plural_form(raw: string, lang: string, n: int) -> string
    if index_of(raw, "|") < 0
        return raw
    end
    let parts = split(raw, "|")
    let order = form_order(lang)
    let cat = plural_category(lang, n)
    let idx = 0
    for f in order
        if f == cat
            break
        end
        idx += 1
    end
    if idx >= len(parts)
        idx = len(parts) - 1
    end
    return trim(parts[idx])
end
##
## Pipe templates (`"one|other"`, `"one|few|many"`) select positionally by
## language form order; single templates are used as-is. The count is
## injected as `{count}`.
##
## ### Parameters
## - `bundle`: Source `I18nBundle`.
## - `key`: Translation key.
## - `n`: Item count.
## - `vars`: Placeholder name -> string value map (or null).
##
## ### Returns
## Interpolated plural string.
pub function plural(bundle, key: string, n: int, vars = null) -> string
    let raw = find_raw(bundle, bundle.lang, key)
    if raw is null
        return key
    end
    return interpolate(select_plural_form(raw, bundle.lang, n), vars_with_count(vars, n))
end

## Translates key in an explicit language (ignoring the bundle default).
pub function tr_in(bundle, lang: string, key: string, vars = null) -> string
    let raw = find_raw(bundle, lang, key)
    if raw is null
        return key
    end
    return interpolate(raw, vars)
end

## Translates a plural key for count n in an explicit language.
##
## Same as `plural` with `lang` overriding the bundle default.
##
## ### Parameters
## - `bundle`: Source `I18nBundle`.
## - `key`: Translation key.
## - `n`: Item count.
## - `lang`: Language id for lookup, forms, and category.
## - `vars`: Placeholder name -> string value map (or null).
##
## ### Returns
## Interpolated plural string.
pub function plural_in(bundle, key: string, n: int, lang: string, vars = null) -> string
    let raw = find_raw(bundle, lang, key)
    if raw is null
        return key
    end
    return interpolate(select_plural_form(raw, lang, n), vars_with_count(vars, n))
end

## Reports whether key resolves anywhere in the bundle language chain.
##
## ### Parameters
## - `bundle`: Source `I18nBundle`.
## - `key`: Translation key.
##
## ### Returns
## `true` when a template exists for key, `false` otherwise.
pub function has(bundle, key: string) -> bool
    if find_raw(bundle, bundle.lang, key) is null
        return false
    end
    return true
end

## Lists keys translated in the fallback language but missing in lang.
##
## Compares exact language ids (no base-language expansion); useful for
## translation coverage reports.
##
## ### Parameters
## - `bundle`: Source `I18nBundle`.
## - `lang`: Language id to audit.
##
## ### Returns
## Array of untranslated key strings.
pub function missing_keys(bundle, lang: string) -> array
    let out = []
    let fb = bundle.fallback
    for k in keys(bundle.messages)
        let pos = index_of(k, "\n")
        if pos > 0
            if k[0..pos] == fb
                let key = k[pos + 1..len(k)]
                let want = lang + "\n" + key
                let present = 0
                if want in bundle.messages
                    present = 1
                end
                if present == 0
                    out.push(key)
                end
            end
        end
    end
    return out
end
