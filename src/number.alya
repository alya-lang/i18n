## # i18n/number
##
## Locale-aware number and calendar-date formatting (CLDR-lite).
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Covers decimal/grouping separators per language family and numeric
## date order per locale. Deliberately lite: non-Latin month/weekday
## scripts beyond table coverage stay on the follow-up list.

import "std/time" as time
import "./plural.alya"

## Decimal separator for a language id (`.` by default).
function decimal_sep(lang: string) -> string
    let b = base_lang(lang)
    return when b
        is "de", "es", "it", "pt", "tr", "nl", "ru", "pl", "cs", "sk" => ","
        is "fr" => ","
        is "ar" => "٫"
        else => "."
    end
end

## Thousands-group separator ("" disables grouping).
function group_sep(lang: string) -> string
    let b = base_lang(lang)
    return when b
        is "de", "es", "it", "pt", "tr", "nl" => "."
        is "fr", "pl", "cs", "sk", "ru" => " "
        is "ar" => "٬"
        is "ja", "zh", "yue", "ko" => ","
        else => ","
    end
end

## Grouping mode: 3 = standard triplets, 4 = CJK quadruplets,
## 32 = Indic (first group of 3 from the right, then pairs).
function group_mode(lang: string) -> int
    let b = base_lang(lang)
    return when b
        is "ja", "zh", "yue", "ko" => 4
        is "hi" => 32
        else => 3
    end
end

## Maps Western digits to Eastern Arabic digits (٠١٢٣٤٥٦٧٨٩).
function arabic_digits(s: string) -> string
    let glyphs = ["٠", "١", "٢", "٣", "٤", "٥", "٦", "٧", "٨", "٩"]
    let out = ""
    let i: int = 0
    while i < len(s)
        let ch = s[i..i + 1]
        let d: int = 0
        let done = 0
        while d < 10
            if "0123456789"[d..d + 1] == ch
                out += glyphs[d]
                done = 1
            end
            d += 1
        end
        if done == 0
            out += ch
        end
        i += 1
    end
    return out
end

## Formats a float with locale separators and fixed decimals.
##
## Rounds half away from zero; negative zero normalizes to `"0..."`.
## `digits` selects Western (`"latn"`, default) or Eastern Arabic
## (`"arab"`, ٠١٢٣٤٥٦٧٨٩) numerals; Arabic keeps Western digits unless
## asked. Hindi groups lakh-style (`12,34,567`), CJK in quadruplets.
##
## ### Parameters
## - `value`: Number to format.
## - `lang`: Language id (defaults to `"en"`).
## - `decimals`: Fractional digit count (non-negative).
## - `digits`: Numeral system (`"latn"` or `"arab"`).
##
## ### Returns
## Formatted number string.
##
## ### Throws
## Negative decimals, or decimals above 18 (`10^19` overflows int64).
pub function format_number(value: float, lang: string = "en", decimals: int = 2, digits: string = "latn") -> string
    if decimals < 0 or decimals > 18
        throw "format_number requires decimals in 0..18"
    end
    let scale: int = 1
    let d: int = 0
    while d < decimals
        scale *= 10
        d += 1
    end
    let sign = ""
    if value < 0.0
        sign = "-"
    end
    let scaled: int = int(value * scale)
    if value >= 0.0
        scaled = int(value * scale + 0.5)
    else
        scaled = int(value * scale - 0.5)
    end
    if scaled < 0
        scaled = -scaled
    end
    if scaled == 0
        sign = ""
    end
    let int_part: int = scaled / scale
    let frac_part: int = scaled - int_part * scale
    let digits_str = str(int_part)
    let gsep = group_sep(lang)
    let mode = group_mode(lang)
    if len(digits_str) > 3
        let grouped = ""
        let pos: int = len(digits_str)
        let first = 1
        while pos > 0
            let sz = 3
            if mode == 4
                sz = 4
            elif mode == 32 and first == 0
                sz = 2
            end
            let start: int = pos - sz
            if start < 0
                start = 0
            end
            let chunk = digits_str[start..pos]
            if len(grouped) == 0
                grouped = chunk
            else
                grouped = chunk + gsep + grouped
            end
            pos = start
            first = 0
        end
        digits_str = grouped
    end
    let out = sign + digits_str
    if decimals > 0
        let frac = str(frac_part)
        while len(frac) < decimals
            frac = "0" + frac
        end
        out += decimal_sep(lang) + frac
    end
    if digits == "arab"
        return arabic_digits(out)
    end
    return out
end

## Date field order for a language id: "MDY", "DMY", or "YMD".
function date_order(lang: string) -> string
    let b = base_lang(lang)
    return when b
        is "en" => "MDY"
        is "ja", "zh", "yue", "ko" => "YMD"
        else => "DMY"
    end
end

## Date field separator for a language id.
function date_separator(lang: string) -> string
    let b = base_lang(lang)
    return when b
        is "en", "es", "it", "pt", "fr", "ar", "ja", "zh", "yue" => "/"
        is "nl" => "-"
        else => "."
    end
end

## Zero-pads a date field to two digits.
function pad2(n: int) -> string
    if n < 10 and n >= 0
        return "0" + str(n)
    end
    return str(n)
end

## Full month names per supported language (English delegates to stdlib).
function months_full(lang: string) -> array
    let b = base_lang(lang)
    return when b
        is "de" => ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"]
        is "fr" => ["janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre"]
        is "es" => ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"]
        is "it" => ["gennaio", "febbraio", "marzo", "aprile", "maggio", "giugno", "luglio", "agosto", "settembre", "ottobre", "novembre", "dicembre"]
        is "pt" => ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"]
        is "tr" => ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"]
        is "nl" => ["januari", "februari", "maart", "april", "mei", "juni", "juli", "augustus", "september", "oktober", "november", "december"]
        is "ru" => ["Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"]
        is "ar" => ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"]
        is "ja", "zh", "yue" => ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"]
        is "ko" => ["1월", "2월", "3월", "4월", "5월", "6월", "7월", "8월", "9월", "10월", "11월", "12월"]
        else => ["", "", "", "", "", "", "", "", "", "", "", ""]
    end
end

## Abbreviated month names per supported language.
function months_short(lang: string) -> array
    let b = base_lang(lang)
    return when b
        is "de" => ["Jan", "Feb", "Mär", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Dez"]
        is "fr" => ["janv.", "févr.", "mars", "avr.", "mai", "juin", "juil.", "août", "sept.", "oct.", "nov.", "déc."]
        is "es" => ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sept", "oct", "nov", "dic"]
        is "it" => ["gen", "feb", "mar", "apr", "mag", "giu", "lug", "ago", "set", "ott", "nov", "dic"]
        is "pt" => ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"]
        is "tr" => ["Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara"]
        is "nl" => ["jan", "feb", "mrt", "apr", "mei", "jun", "jul", "aug", "sep", "okt", "nov", "dec"]
        is "ru" => ["янв", "фев", "мар", "апр", "май", "июн", "июл", "авг", "сен", "окт", "ноя", "дек"]
        is "ar" => ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"]
        is "ja", "zh", "yue" => ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"]
        is "ko" => ["1월", "2월", "3월", "4월", "5월", "6월", "7월", "8월", "9월", "10월", "11월", "12월"]
        else => ["", "", "", "", "", "", "", "", "", "", "", ""]
    end
end

## Returns the full month name for a language id.
##
## English (and uncovered languages) delegate to `std/time`. Russian uses
## the nominative case (dates ideally want the genitive — documented
## simplification).
##
## ### Parameters
## - `lang`: Language id.
## - `month`: Month number 1-12.
##
## ### Returns
## Full month name, or `"Unknown"` when out of range.
pub function month_name(lang: string, month: int) -> string
    if month < 1 or month > 12
        return "Unknown"
    end
    let b = base_lang(lang)
    if b == "en"
        return time::month_name(month)
    end
    let table = months_full(lang)
    if table[0] == ""
        return time::month_name(month)
    end
    return table[month - 1]
end

## Returns the abbreviated month name for a language id.
##
## ### Parameters
## - `lang`: Language id.
## - `month`: Month number 1-12.
##
## ### Returns
## Abbreviated month name, or `"Unk"` when out of range.
pub function month_short(lang: string, month: int) -> string
    if month < 1 or month > 12
        return "Unk"
    end
    let b = base_lang(lang)
    if b == "en"
        return time::month_short_name(month)
    end
    let table = months_short(lang)
    if table[0] == ""
        return time::month_short_name(month)
    end
    return table[month - 1]
end

## Formats a calendar date with the locale month name.
##
## English uses `"December 31, 2024"` order; other covered languages use
## simplified `"{day} {month} {year}"` (particles dropped, documented).
##
## ### Parameters
## - `year`: Full year (e.g. `2024`).
## - `month`: Month number 1-12.
## - `day`: Day number 1-31.
## - `lang`: Language id (defaults to `"en"`).
##
## ### Returns
## Named date string.
pub function format_date_named(year: int, month: int, day: int, lang: string = "en") -> string
    let name = month_name(lang, month)
    let b = base_lang(lang)
    if b == "en"
        return name + " " + str(day) + ", " + str(year)
    end
    return str(day) + " " + name + " " + str(year)
end

## Full weekday names per supported language (English via stdlib).
function weekdays_full(lang: string) -> array
    let b = base_lang(lang)
    return when b
        is "de" => ["Sonntag", "Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag"]
        is "fr" => ["dimanche", "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi"]
        is "es" => ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"]
        is "it" => ["domenica", "lunedì", "martedì", "mercoledì", "giovedì", "venerdì", "sabato"]
        is "pt" => ["domingo", "segunda-feira", "terça-feira", "quarta-feira", "quinta-feira", "sexta-feira", "sábado"]
        is "tr" => ["Pazar", "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi"]
        is "nl" => ["zondag", "maandag", "dinsdag", "woensdag", "donderdag", "vrijdag", "zaterdag"]
        is "ru" => ["воскресенье", "понедельник", "вторник", "среда", "четверг", "пятница", "суббота"]
        is "ar" => ["الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"]
        is "ja", "zh", "yue" => ["日曜日", "月曜日", "火曜日", "水曜日", "木曜日", "金曜日", "土曜日"]
        is "ko" => ["일요일", "월요일", "화요일", "수요일", "목요일", "금요일", "토요일"]
        else => ["", "", "", "", "", "", ""]
    end
end

## Abbreviated weekday names per supported language.
function weekdays_short(lang: string) -> array
    let b = base_lang(lang)
    return when b
        is "de" => ["So", "Mo", "Di", "Mi", "Do", "Fr", "Sa"]
        is "fr" => ["dim.", "lun.", "mar.", "mer.", "jeu.", "ven.", "sam."]
        is "es" => ["dom", "lun", "mar", "mié", "jue", "vie", "sáb"]
        is "it" => ["dom", "lun", "mar", "mer", "gio", "ven", "sab"]
        is "pt" => ["dom", "seg", "ter", "qua", "qui", "sex", "sáb"]
        is "tr" => ["Paz", "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt"]
        is "nl" => ["zo", "ma", "di", "wo", "do", "vr", "za"]
        is "ru" => ["вс", "пн", "вт", "ср", "чт", "пт", "сб"]
        is "ar" => ["أحد", "اثنين", "ثلاثاء", "أربعاء", "خميس", "جمعة", "سبت"]
        is "ja", "zh", "yue" => ["日", "月", "火", "水", "木", "金", "土"]
        is "ko" => ["일", "월", "화", "수", "목", "금", "토"]
        else => ["", "", "", "", "", "", ""]
    end
end

## Returns the full weekday name for a language id (Sunday is 0).
##
## English (and uncovered languages) delegate to `std/time`.
##
## ### Parameters
## - `lang`: Language id.
## - `weekday`: Weekday number with Sunday as 0.
##
## ### Returns
## Full weekday name, or `"Unknown"` when out of range.
pub function weekday_name(lang: string, weekday: int) -> string
    if weekday < 0 or weekday > 6
        return "Unknown"
    end
    let b = base_lang(lang)
    if b == "en"
        return time::weekday_name(weekday)
    end
    let table = weekdays_full(lang)
    if table[0] == ""
        return time::weekday_name(weekday)
    end
    return table[weekday]
end

## Returns the abbreviated weekday name for a language id (Sunday is 0).
##
## ### Parameters
## - `lang`: Language id.
## - `weekday`: Weekday number with Sunday as 0.
##
## ### Returns
## Abbreviated weekday name, or `"Unk"` when out of range.
pub function weekday_short(lang: string, weekday: int) -> string
    if weekday < 0 or weekday > 6
        return "Unk"
    end
    let b = base_lang(lang)
    if b == "en"
        return time::weekday_short_name(weekday)
    end
    let table = weekdays_short(lang)
    if table[0] == ""
        return time::weekday_short_name(weekday)
    end
    return table[weekday]
end

## Computes the weekday for a Gregorian date (Sunday is 0).
##
## Zeller's congruence; valid for proleptic Gregorian dates with
## year >= 1. All terms stay non-negative, so truncation is exact.
function weekday_of_ymd(year: int, month: int, day: int) -> int
    let m: int = month
    let y: int = year
    if m <= 2
        m += 12
        y -= 1
    end
    let q: int = day
    let k: int = y % 100
    let j: int = (y - k) / 100
    let h: int = q + (13 * (m + 1)) / 5 + k + k / 4 + j / 4 + 5 * j
    h = h % 7
    return (h + 6) % 7
end

## Formats a full calendar date with weekday and month names.
##
## English uses `"Tuesday, December 31, 2024"`; other covered languages
## use simplified `"{weekday} {day} {month} {year}"`.
##
## ### Parameters
## - `year`: Full year (e.g. `2024`, >= 1).
## - `month`: Month number 1-12.
## - `day`: Day number 1-31.
## - `lang`: Language id (defaults to `"en"`).
##
## ### Returns
## Full named date string.
pub function format_date_full(year: int, month: int, day: int, lang: string = "en") -> string
    let wd = weekday_name(lang, weekday_of_ymd(year, month, day))
    let name = month_name(lang, month)
    let b = base_lang(lang)
    if b == "en"
        return wd + ", " + name + " " + str(day) + ", " + str(year)
    end
    return wd + " " + str(day) + " " + name + " " + str(year)
end

## Reports whether a language id uses the 12-hour clock.
function uses_12h(lang: string) -> bool
    let b = base_lang(lang)
    return when b
        is "en", "ar" => true
        else => false
    end
end

## AM/PM markers for 12-hour languages ([am, pm]).
function day_periods(lang: string) -> array
    let b = base_lang(lang)
    return when b
        is "ar" => ["ص", "م"]
        else => ["AM", "PM"]
    end
end

## Formats a time of day in locale convention.
##
## 12-hour languages (`en`, `ar`) render `h:MM AM/PM`; the rest render
## zero-padded 24-hour `HH:MM`.
##
## ### Parameters
## - `hour`: Hour 0-23.
## - `minute`: Minute 0-59.
## - `lang`: Language id (defaults to `"en"`).
##
## ### Returns
## Formatted time string.
##
## ### Throws
## Hour/minute out of range.
pub function format_time(hour: int, minute: int, lang: string = "en") -> string
    if hour < 0 or hour > 23 or minute < 0 or minute > 59
        throw "format_time requires hour 0..23 and minute 0..59"
    end
    if uses_12h(lang)
        let marks = day_periods(lang)
        let h12: int = hour % 12
        if h12 == 0
            h12 = 12
        end
        let suffix = marks[0]
        if hour >= 12
            suffix = marks[1]
        end
        return str(h12) + ":" + pad2(minute) + " " + suffix
    end
    return pad2(hour) + ":" + pad2(minute)
end

## Past wrapper for a formatted duration ("3 days ago", "vor 3 Tagen").
function past_wrap(lang: string, text: string) -> string
    let b = base_lang(lang)
    return when b
        is "de" => "vor " + text
        is "fr" => "il y a " + text
        is "es" => "hace " + text
        is "tr" => text + " önce"
        is "ar" => "منذ " + text
        is "ja", "zh", "yue" => text + "前"
        is "ko" => text + " 전"
        else => text + " ago"
    end
end

## Future wrapper for a formatted duration ("in 3 days", "in 3 Tagen").
function future_wrap(lang: string, text: string) -> string
    let b = base_lang(lang)
    return when b
        is "de" => "in " + text
        is "fr" => "dans " + text
        is "es" => "en " + text
        is "tr" => text + " sonra"
        is "ar" => "بعد " + text
        is "ja", "zh", "yue" => text + "後"
        is "ko" => text + " 후"
        else => "in " + text
    end
end

## Formats a past relative time from a bundle unit template.
##
## Looks up `time.<unit>` (e.g. `"time.day"` → `"one day|{{count}} days"`)
## via `plural_in`, then wraps it ("3 days ago"). Missing templates fall
## back to the key itself, per `plural_in` semantics.
##
## ### Parameters
## - `bundle`: Source `I18nBundle` holding `time.<unit>` templates.
## - `lang`: Language id.
## - `n`: Item count.
## - `unit`: Time unit key (`"second"`, `"minute"`, `"hour"`, `"day"`, `"week"`, `"month"`, `"year"`).
##
## ### Returns
## Localized past relative-time string.
pub function relative_past(bundle, lang: string, n: int, unit: string) -> string
    return past_wrap(lang, plural_in(bundle, "time." + unit, n, lang))
end

## Formats a future relative time from a bundle unit template.
##
## ### Parameters
## - `bundle`: Source `I18nBundle` holding `time.<unit>` templates.
## - `lang`: Language id.
## - `n`: Item count.
## - `unit`: Time unit key.
##
## ### Returns
## Localized future relative-time string.
pub function relative_future(bundle, lang: string, n: int, unit: string) -> string
    return future_wrap(lang, plural_in(bundle, "time." + unit, n, lang))
end

## Currency symbol and default decimals ([symbol, decimals]).
function currency_info(code: string) -> array
    return when code
        is "USD" => ["$", 2]
        is "EUR" => ["€", 2]
        is "GBP" => ["£", 2]
        is "JPY" => ["¥", 0]
        is "TRY" => ["₺", 2]
        is "RUB" => ["₽", 2]
        is "CNY" => ["¥", 2]
        is "SAR" => ["ر.س", 2]
        is "CHF" => ["CHF", 2]
        is "SEK" => ["kr", 2]
        is "NOK" => ["kr", 2]
        is "DKK" => ["kr", 2]
        is "AED" => ["د.إ", 2]
        is "PLN" => ["zł", 2]
        is "CZK" => ["Kč", 2]
        is "HUF" => ["Ft", 0]
        is "ILS" => ["₪", 2]
        is "BRL" => ["R$", 2]
        is "INR" => ["₹", 2]
        is "KRW" => ["₩", 0]
        is "CAD" => ["CA$", 2]
        is "AUD" => ["A$", 2]
        else => [code, 2]
    end
end

## Renders a monetary amount with locale separators and currency symbol.
##
## Symbol position is per language (prefix without space for `en`/`tr`/
## CJK, prefix with space for `nl`, suffix with space elsewhere).
## Unknown currency codes render as-is in prefix position.
##
## ### Parameters
## - `value`: Monetary amount.
## - `lang`: Language id (defaults to `"en"`).
## - `currency`: ISO 4217 code (`"USD"`, `"EUR"`, ...).
## - `decimals`: Fractional digits (`-1` keeps the currency default).
##
## ### Returns
## Formatted money string.
pub function format_money(value: float, lang: string = "en", currency: string = "USD", decimals: int = -1) -> string
    let info = currency_info(currency)
    let symbol = info[0]
    let dec: int = info[1]
    if decimals >= 0
        dec = decimals
    end
    let amount = format_number(value, lang, dec)
    let b = base_lang(lang)
    return when b
        is "en", "tr", "ja", "zh", "yue", "ko" => symbol + amount
        is "nl" => symbol + " " + amount
        else => amount + " " + symbol
    end
end

## Formats an ordinal number for a language id.
##
## English applies the 11-13 exception (`11th`, not `11st`); French uses
## the masculine `1er` (no gender info available); German/Turkish use a
## trailing dot (Turkish suffix harmony simplified away).
##
## ### Parameters
## - `n`: Ordinal number.
## - `lang`: Language id (defaults to `"en"`).
##
## ### Returns
## Ordinal string.
pub function ordinal(n: int, lang: string = "en") -> string
    let b = base_lang(lang)
    return when b
        is "en" => ordinal_en(n)
        is "es", "it", "pt" => str(n) + "º"
        is "fr" => ordinal_fr(n)
        is "de", "tr" => str(n) + "."
        is "nl" => str(n) + "e"
        else => str(n)
    end
end

## English ordinal with the 11-13 exception.
function ordinal_en(n: int) -> string
    let v: int = n
    if v < 0
        v = -v
    end
    let last_two: int = v % 100
    if last_two >= 11 and last_two <= 13
        return str(n) + "th"
    end
    let last: int = v % 10
    if last == 1
        return str(n) + "st"
    end
    if last == 2
        return str(n) + "nd"
    end
    if last == 3
        return str(n) + "rd"
    end
    return str(n) + "th"
end

## French ordinal (masculine `1er`, plural `1ers` unknown here).
function ordinal_fr(n: int) -> string
    if n == 1
        return "1er"
    end
    return str(n) + "e"
end

## Formats a numeric calendar date in locale order (no month names).
##
## Korean trailing-dot style simplifies to dots (`2024.12.31`).
##
## ### Parameters
## - `year`: Full year (e.g. `2024`).
## - `month`: Month number 1-12.
## - `day`: Day number 1-31.
## - `lang`: Language id (defaults to `"en"`).
##
## ### Returns
## Locale-ordered date string.
pub function format_date_ymd(year: int, month: int, day: int, lang: string = "en") -> string
    let sep = date_separator(lang)
    let order = date_order(lang)
    if order == "MDY"
        return pad2(month) + sep + pad2(day) + sep + str(year)
    end
    if order == "YMD"
        return str(year) + sep + pad2(month) + sep + pad2(day)
    end
    return pad2(day) + sep + pad2(month) + sep + str(year)
end
