## # i18n/toml_loader
##
## TOML translation loader with `[table]` section support.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## `[table]` sections map to dotted keys (`[menu]` + `file = "x"` becomes
## `menu.file`; `[a.b]` nests to `a.b.`). Only quoted string values are
## consumed: unquoted scalars arrive typed and cannot be pinned safely.
## `[[array-table]]` sections are skipped. Values come from the real
## `toml` parser per section (identical unescaping), so this file only
## groups lines and never parses values itself.

import "std/str"
import "toml" as toml_pkg

## Strips one layer of matching quotes (`"..."`, `'...'`), else untouched.
function unquote_toml(s: string) -> string
    if len(s) >= 2
        let first = s[0..1]
        let last = s[len(s) - 1..len(s)]
        if first == "\"" and last == "\""
            return s[1..len(s) - 1]
        end
        if first == "'" and last == "'"
            return s[1..len(s) - 1]
        end
    end
    return s
end

## Parses TOML translation text into a key -> template map.
##
## Top-level pairs keep their keys; `[table]` pairs gain a dotted prefix.
##
## ### Parameters
## - `text`: Raw TOML document content.
##
## ### Returns
## Flat map of translation keys to template strings.
pub function parse_toml_text(text) -> map
    let out = map()
    if text is null or len(text) == 0
        return out
    end
    # Group raw lines into sections: "" (top) plus one bucket per [table].
    # "@skip" collects [[array-table]] lines, which are never parsed.
    let order = []
    let bodies = map()
    bodies[""] = ""
    bodies["@skip"] = ""
    let cur = ""
    for line in lines(text)
        let t = trim(line)
        if len(t) == 0 or starts_with(t, "#") == 1
            continue
        end
        if starts_with(t, "[[") == 1
            # Array tables hold non-string values: skip wholesale.
            cur = "@skip"
            continue
        end
        if starts_with(t, "[") == 1 and ends_with(t, "]") == 1
            let inner = trim(t[1..len(t) - 1])
            cur = unquote_toml(inner) + "."
            bodies[cur] = ""
            continue
        end
        if cur == "@skip"
            continue
        end
        let eq = index_of(t, "=")
        if eq <= 0
            continue
        end
        let raw_key = trim(t[0..eq])
        let raw_val = trim(t[eq + 1..len(t)])
        if starts_with(raw_val, "\"") == 0 and starts_with(raw_val, "'") == 0
            continue
        end
        let key = unquote_toml(raw_key)
        bodies[cur] = bodies[cur] + key + " = " + raw_val + "\n"
        let seen = 0
        for have in order
            if have == cur
                seen = 1
            end
        end
        if seen == 0
            order.push(cur)
        end
    end
    # Parse each bucket with the real parser; keys are top-level there.
    for sec in order
        let data = toml_pkg::parse(bodies[sec])
        if data is null
            continue
        end
        for k in keys(data)
            out[sec + k] = str_from_ptr(data[k])
        end
    end
    return out
end
