## i18n Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Canonical domain models for internationalization.
##
## Storage rule: message tables are FLAT. Composite keys join language and
## key with a newline (`"en\nmsg_hello"`), and every value is a plain
## template string (plural variants use pipe-separated templates such as
## `"one item|{count} items"`). Native map subscript with a runtime key
## yields an unboxed pointer for heap values, so all variable-key reads of
## strings are pinned with `str_from_ptr` at the boundary.

import "std/str"

## Locale message bundle: flat composite-key message table.
##
## ### Fields
## - `messages`: Flat `"lang\nkey"` -> template string map.
## - `lang`: Active language id (`"tr"`, `"en-US"`).
## - `fallback`: Fallback language id used when a key is missing (`"en"`).
pub struct I18nBundle
    messages: map,
    lang: string,
    fallback: string
end

## Creates an empty bundle with active and fallback languages.
##
## ### Parameters
## - `lang`: Active language id. Defaults to `"en"`.
## - `fallback`: Fallback language id. Defaults to `"en"`.
##
## ### Returns
## Initialized `I18nBundle` with an empty message table.
pub function bundle_new(lang: string = "en", fallback: string = "en") -> I18nBundle
    return I18nBundle {
        messages: map(),
        lang: lang,
        fallback: fallback
    }
end

## Merges a flat key -> template map under a language id.
##
## ### Parameters
## - `self`: Target bundle.
## - `lang`: Language id for the entries.
## - `langmap`: Flat key -> template string map.
##
## ### Returns
## The bundle with entries merged in.
pub function I18nBundle.put_lang(self: I18nBundle, lang: string, langmap) -> I18nBundle
    if langmap is null
        return self
    end
    for k in keys(langmap)
        self.messages[lang + "\n" + k] = str_from_ptr(langmap[k])
    end
    return self
end

## Switches the active language, returning the updated bundle.
##
## ### Parameters
## - `self`: Target bundle.
## - `lang`: New active language id.
##
## ### Returns
## New bundle value with `lang` updated.
pub function I18nBundle.set_lang(self: I18nBundle, lang: string) -> I18nBundle
    return I18nBundle {
        messages: self.messages,
        lang: lang,
        fallback: self.fallback
    }
end

## Returns the language ids present in this bundle.
##
## ### Parameters
## - `self`: Target bundle.
##
## ### Returns
## Array of language id strings.
pub function I18nBundle.langs(self: I18nBundle) -> array
    let out = []
    for ck in keys(self.messages)
        let sep = index_of(ck, "\n")
        let l = ck
        if sep > 0
            l = ck[..sep]
        end
        let found = 0
        for x in out
            if x == l
                found = 1
            end
        end
        if found == 0
            out.push(l)
        end
    end
    return out
end
