## Example usage and walkthrough for i18n
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/fs"
import "../src/lib.alya" as pkg

## Resolves the demo translation directory regardless of the runner CWD.
function demo_dir() -> string
    if len(fs_list_dir("examples/translations")) > 0
        return "examples/translations"
    end
    return "Lib/i18n/examples/translations"
end

function main()
    say "=== i18n Package Showcase ==="
    say ""

    say "--- 1. Inline bundle ---"
    let enm = map()
    enm["hello"] = "Hi"
    let goods_tpl = """one item|{{count}} items"""
    enm["goods"] = goods_tpl
    let b = pkg::bundle_new("en", "en")
    let b = b.put_lang("en", enm)
    say "t:       " + pkg::t(b, "hello")
    say "plural1: " + pkg::plural(b, "goods", 1)
    say "plural5: " + pkg::plural(b, "goods", 5)
    let v = map()
    v["name"] = "Zeynep"
    say "vars:    " + pkg::t(b, "hello", v)
    say ""

    say "--- 2. Directory loading ---"
    let dir = demo_dir()
    let lb = pkg::load_bundle(dir, "tr", "en")
    say "tr hello: " + pkg::t(lb, "msg_hello")
    say "tr items: " + pkg::plural(lb, "items", 3)
    let w = map()
    w["name"] = "Ali"
    say "tr welc:  " + pkg::t(lb, "welcome", w)
    say "langs:   " + str(len(lb.langs()))
    say ""

    say "--- 3. Fallback chain ---"
    let fb = pkg::bundle_new("de", "en")
    fb = fb.put_lang("en", enm)
    say "de->en:  " + pkg::t(fb, "hello")
    say "missing: " + pkg::t(fb, "no.such.key")
    say ""

    say "--- 4. System language ---"
    say "system:  " + pkg::system_language("en")
    say ""
    say "Done!"
end

main()
