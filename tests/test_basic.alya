## Test suite for i18n
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "std/fs"
import "../src/lib.alya" as pkg

## Resolves the fixture directory regardless of the runner CWD.
function fixture_dir() -> string
    if len(fs_list_dir("tests/translations")) > 0
        return "tests/translations"
    end
    return "Lib/i18n/tests/translations"
end

function test_tr_parsing(r)
    let tr_text = """
msg_hello
Hello
-----
goods
one item|{{count}} items
-----
multiline
line one
line two
-----
trailing
no separator here"""
    let tr_map = pkg::parse_tr_text(tr_text)
    runner_assert_str_eq(r, tr_map["msg_hello"], "Hello", "tr parses simple entry")
    runner_assert_eq(r, starts_with(tr_map["goods"], "one item|"), 1, "tr keeps pipe value head")
    runner_assert_eq(r, ends_with(tr_map["goods"], " items"), 1, "tr keeps pipe value tail")
    runner_assert_str_eq(r, tr_map["multiline"], "line one\nline two", "tr keeps multiline values")
    runner_assert_str_eq(r, tr_map["trailing"], "no separator here", "tr reads trailing entry")
    runner_assert_eq(r, len(keys(pkg::parse_tr_text(""))), 0, "tr empty text gives empty map")
    runner_assert_eq(r, len(keys(pkg::parse_tr_text(null))), 0, "tr null text gives empty map")
end

function test_json_flat(r)
    runner_assert_eq(r, len(keys(pkg::parse_json_text("nope"))), 0, "json invalid text gives empty map")
    runner_assert_eq(r, len(keys(pkg::parse_json_text("[1,2]"))), 0, "json non-object root gives empty map")
    runner_assert_eq(r, len(keys(pkg::parse_json_text(""))), 0, "json empty text gives empty map")
end

function test_plural_categories(r)
    runner_assert_str_eq(r, pkg::plural_category("en", 0), "other", "en 0 -> other")
    runner_assert_str_eq(r, pkg::plural_category("en", 1), "one", "en 1 -> one")
    runner_assert_str_eq(r, pkg::plural_category("en", 2), "other", "en 2 -> other")
    runner_assert_str_eq(r, pkg::plural_category("tr", 1), "other", "tr has no singular")
    runner_assert_str_eq(r, pkg::plural_category("ru", 1), "one", "ru 1 -> one")
    runner_assert_str_eq(r, pkg::plural_category("ru", 2), "few", "ru 2 -> few")
    runner_assert_str_eq(r, pkg::plural_category("ru", 5), "many", "ru 5 -> many")
    runner_assert_str_eq(r, pkg::plural_category("ru", 11), "many", "ru 11 -> many")
    runner_assert_str_eq(r, pkg::plural_category("ru", 21), "one", "ru 21 -> one")
    runner_assert_str_eq(r, pkg::plural_category("ru", 111), "many", "ru 111 -> many")
    runner_assert_str_eq(r, pkg::plural_category("ar", 0), "zero", "ar 0 -> zero")
    runner_assert_str_eq(r, pkg::plural_category("ar", 1), "one", "ar 1 -> one")
    runner_assert_str_eq(r, pkg::plural_category("ar", 2), "two", "ar 2 -> two")
    runner_assert_str_eq(r, pkg::plural_category("ar", 5), "few", "ar 5 -> few")
    runner_assert_str_eq(r, pkg::plural_category("ar", 15), "many", "ar 15 -> many")
    runner_assert_str_eq(r, pkg::plural_category("ar", 100), "other", "ar 100 -> other")
    runner_assert_str_eq(r, pkg::plural_category("fr", 0), "one", "fr 0 -> one")
    runner_assert_str_eq(r, pkg::plural_category("fr", 2), "other", "fr 2 -> other")
    runner_assert_str_eq(r, pkg::plural_category("pl", 1), "one", "pl 1 -> one")
    runner_assert_str_eq(r, pkg::plural_category("pl", 3), "few", "pl 3 -> few")
    runner_assert_str_eq(r, pkg::plural_category("pl", 12), "many", "pl 12 -> many")
    runner_assert_str_eq(r, pkg::plural_category("cs", 1), "one", "cs 1 -> one")
    runner_assert_str_eq(r, pkg::plural_category("cs", 3), "few", "cs 3 -> few")
    runner_assert_str_eq(r, pkg::plural_category("cs", 5), "other", "cs 5 -> other")
    runner_assert_str_eq(r, pkg::plural_category("en", -1), "other", "negative count -> other")
    runner_assert_str_eq(r, pkg::base_lang("pt-BR"), "pt", "base_lang strips region")
end

function test_interpolate(r)
    let ob2 = "{{}}"[..1]
    let cb2 = "{{}}"[1..]
    let ptmpl = "Hi " + ob2 + "name" + cb2
    let pv = map()
    pv["name"] = "Ali"
    runner_assert_str_eq(r, pkg::interpolate(ptmpl, pv), "Hi Ali", "probe-first interpolate")
    let tmpl = """Hello, {{name}}! You have {{count}} messages."""
    let v = map()
    v["name"] = "Ali"
    v["count"] = "3"
    runner_assert_str_eq(r, pkg::interpolate(tmpl, v), "Hello, Ali! You have 3 messages.", "interpolate replaces placeholders")
    runner_assert_str_eq(r, pkg::interpolate("plain", null), "plain", "interpolate null vars passes through")
    let tmpl2 = """Hi {{who}}"""
    let v2 = map()
    v2["name"] = "Ali"
    runner_assert_str_eq(r, pkg::interpolate(tmpl2, v2), tmpl2, "interpolate leaves unknown keys")
end

function test_inline_bundle(r)
    let enm = map()
    enm["hello"] = "Hi"
    let goods_tpl = """one item|{{count}} items"""
    enm["goods"] = goods_tpl
    let b = pkg::bundle_new("en", "en")
    let b = b.put_lang("en", enm)
    runner_assert_eq(r, len(b.langs()), 1, "langs lists loaded languages")
    runner_assert_str_eq(r, pkg::t(b, "hello"), "Hi", "t returns translation")
end

function test_pipe_families(r)
    let rum = map()
    rum["apple"] = "one_ru|few_ru|many_ru"
    let rb = pkg::bundle_new("ru", "en")
    let rb = rb.put_lang("ru", rum)
    runner_assert_str_eq(r, pkg::plural(rb, "apple", 1), "one_ru", "ru plural one")
    runner_assert_str_eq(r, pkg::plural(rb, "apple", 22), "few_ru", "ru plural few")
    runner_assert_str_eq(r, pkg::plural(rb, "apple", 25), "many_ru", "ru plural many")
    let arm = map()
    arm["msg"] = "zero_ar|one_ar|two_ar|few_ar|many_ar|other_ar"
    let ab = pkg::bundle_new("ar", "en")
    let ab = ab.put_lang("ar", arm)
    runner_assert_str_eq(r, pkg::plural(ab, "msg", 0), "zero_ar", "ar plural zero")
    runner_assert_str_eq(r, pkg::plural(ab, "msg", 2), "two_ar", "ar plural two")
    runner_assert_str_eq(r, pkg::plural(ab, "msg", 100), "other_ar", "ar plural other")
end

function test_fallback_chain(r)
    let fbm = map()
    fbm["hi"] = "Hello"
    let fb = pkg::bundle_new("de", "en")
    let fb = fb.put_lang("en", fbm)
    runner_assert_str_eq(r, pkg::t(fb, "hi"), "Hello", "t falls back to fallback lang")
    let usb = pkg::bundle_new("en-US", "en")
    let usb = usb.put_lang("en", fbm)
    runner_assert_str_eq(r, pkg::t(usb, "hi"), "Hello", "t falls back to base lang")
    let b2 = pkg::bundle_new("en", "en")
    let b2de = b2.set_lang("de")
    runner_assert_str_eq(r, b2de.lang, "de", "set_lang switches language")
    runner_assert_eq(r, len(b2de.langs()), 0, "empty bundle has no languages")
end

function test_load_dir(r)
    let dir = fixture_dir()
    let lb = pkg::load_bundle(dir, "tr", "en")
    runner_assert_str_eq(r, pkg::t(lb, "msg_hello"), "Merhaba", "load_dir reads .tr files")
    runner_assert_str_eq(r, pkg::t(lb, "menu.file"), "File", "load_dir reads dotted JSON keys")
    runner_assert_str_eq(r, pkg::plural(lb, "goods", 3), "3 öğe", "load_dir reads locale plural")
    let enb = pkg::load_bundle(dir, "en", "en")
    runner_assert_str_eq(r, pkg::t(enb, "msg_hello"), "Hello", ".tr wins over .json")
    runner_assert_str_eq(r, pkg::plural(enb, "cart", 1), "one article", "load_dir reads JSON pipe plurals")
    runner_assert_str_eq(r, pkg::plural(enb, "cart", 4), "4 articles", "JSON plural other with count")
    let wvars = map()
    wvars["name"] = "Zeynep"
    runner_assert_str_eq(r, pkg::t(enb, "farewell", wvars), "Goodbye, Zeynep!", "load_dir templates interpolate vars")
    let deb = pkg::load_bundle(dir, "de", "en")
    runner_assert_str_eq(r, pkg::t(deb, "app.title"), "Titel", "load_dir namespaces subdirectories")
    runner_assert_str_eq(r, pkg::t(deb, "app.logout"), "Abmelden", "load_dir reads namespaced keys")
    runner_assert_str_eq(r, pkg::t(deb, "msg_hello"), "Hello", "missing keys fall back across languages")
    runner_assert_eq(r, len(deb.langs()), 3, "three fixture languages loaded")
end

function test_detect_lang(r)
    runner_assert_true(r, len(pkg::detect_lang()) > 0, "detect_lang returns non-empty tag")
    runner_assert_true(r, len(pkg::system_language("en")) > 0, "system_language returns non-empty tag")
end

function main()
    test_suite("i18n Test Suite")
    let r = runner_new()
    test_tr_parsing(r)
    test_json_flat(r)
    test_plural_categories(r)
    test_interpolate(r)
    test_inline_bundle(r)
    test_pipe_families(r)
    test_fallback_chain(r)
    test_load_dir(r)
    test_detect_lang(r)
    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
