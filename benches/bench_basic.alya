## Benchmark suite for i18n
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("i18n Micro-Benchmarks")

    let enm = map()
    enm["hello"] = "Hi"
    let goods_tpl = """one item|{{count}} items"""
    enm["goods"] = goods_tpl
    let b = pkg::bundle_new("en", "en")
    let b = b.put_lang("en", enm)
    let v = map()
    v["name"] = "Ali"

    # Bench 1: t() lookup — 100k iterations
    bench_start(runner, 100000)
    let i = 0
    while i < 100000
        pkg::t(b, "hello")
        i += 1
    end
    bench_stop(runner, "t() 100k calls")

    # Bench 2: t() with vars — 100k iterations
    bench_start(runner, 100000)
    let j = 0
    while j < 100000
        pkg::t(b, "hello", v)
        j += 1
    end
    bench_stop(runner, "t() with vars 100k calls")

    # Bench 3: plural() — 100k iterations
    bench_start(runner, 100000)
    let k = 0
    while k < 100000
        pkg::plural(b, "goods", 3)
        k += 1
    end
    bench_stop(runner, "plural() 100k calls")

    # Bench 4: parse_tr_text() — 10k iterations
    let sample = "msg_hello\nHello\n-----\ngoods\none item|7 items\n-----"
    bench_start(runner, 10000)
    let m = 0
    while m < 10000
        pkg::parse_tr_text(sample)
        m += 1
    end
    bench_stop(runner, "parse_tr_text() 10k calls")

    # Bench 5: plural_category() — 200k iterations
    bench_start(runner, 200000)
    let s = 0
    while s < 200000
        pkg::plural_category("ru", 22)
        s += 1
    end
    bench_stop(runner, "plural_category() 200k calls")

    bench_summary(runner)
end

main()
